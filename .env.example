# ─── FYP Web (Next.js clone of myFypProject) environment ──────────────────────
# The original ASP.NET Core backend. The React Native app used these exact
# options in assets/config.js. Point this at YOUR running backend.

# OPTION 1: Published IIS Backend (this is what the RN app ships with)
NEXT_PUBLIC_API_BASE=http://192.168.100.13/Fyp_Backend

# OPTION 2: Visual Studio dev — physical device on the same Wi-Fi
# NEXT_PUBLIC_API_BASE=http://10.251.108.219:5150

# OPTION 3: Visual Studio dev — Android emulator (not used in a browser)
# NEXT_PUBLIC_API_BASE=http://10.0.2.2:5139

# OPTION 4: local machine
# NEXT_PUBLIC_API_BASE=http://localhost:5150

# Leaflet map default center (falls back to Rawalpindi, same as the RN app)
NEXT_PUBLIC_MAP_FALLBACK_LAT=33.6844
NEXT_PUBLIC_MAP_FALLBACK_LNG=73.0479
